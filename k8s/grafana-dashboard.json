        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "GKE Active Nodes (Game Server Node Pool)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(kube_node_labels{label_agones_dev_role=\"gameserver\"})",
